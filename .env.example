# Environment Configuration Template
# Copy this file to .env and replace with local secrets

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=pki_user
DB_PASSWORD=change_this_in_production
DB_NAME=pki_lifecycle_db

# ACME / Step-CA Configuration
STEP_CA_URL=https://localhost:9000
STEP_CA_FINGERPRINT=your_ca_fingerprint_here

# Alert Notifications (Telegram / Email)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
